# Environment
NODE_ENV=development

# Server
PORT=5000

# Database (replace USER, PASSWORD, and database name)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/mipqms?schema=public"

# CORS — the origin your frontend will run on (set up in Phase 5)
CORS_ORIGIN=http://localhost:5173

# Auth (Phase 4)
# Generate a real secret with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Must be at least 32 characters — never reuse this placeholder.
JWT_SECRET=replace_this_with_a_long_random_generated_secret_before_running
JWT_EXPIRES_IN=15m

# Seed script only (src/prisma/seed.ts) — creates the first admin account.
# Optional: if omitted, the script falls back to insecure placeholder
# defaults printed to the console. Always change the password after
# first login either way.
SEED_ADMIN_EMAIL=admin@mipqms.local
SEED_ADMIN_PASSWORD=ChangeMe123
